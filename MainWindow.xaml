<Window x:Class="ImageUpscaler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImageUpscaler"
        xmlns:models="clr-namespace:ImageUpscaler.Models"
        mc:Ignorable="d"
        Title="Image Upscaler - Neural Super-Resolution"
        Height="820" Width="1260"
        MinHeight="650" MinWidth="900"
        Background="{StaticResource BrushBgApp}"
        Foreground="{StaticResource BrushTextPrimary}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Toolbar -->
            <RowDefinition Height="*" />    <!-- Main Workspace -->
            <RowDefinition Height="Auto" /> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgHeader}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <DockPanel LastChildFill="False">
                <!-- Left: Quick Action Tools -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource ModernButton}"
                            Click="OnImportImagesClick"
                            ToolTip="Open image files from disk"
                            Margin="0,0,6,0">
                        <TextBlock Text="Import Images" FontWeight="Medium" />
                    </Button>

                    <Button Style="{StaticResource ModernButton}"
                            Click="OnPasteClipboardClick"
                            ToolTip="Paste image from clipboard (Ctrl+V)"
                            Margin="0,0,6,0">
                        <TextBlock Text="Paste Clipboard" />
                    </Button>

                    <Separator Style="{x:Null}" Width="1" Background="{StaticResource BrushBorder}" Margin="6,2,12,2" />

                    <ToggleButton x:Name="SplitViewToggle"
                                  Style="{x:Null}"
                                  IsChecked="False"
                                  Checked="OnSplitViewToggled"
                                  Unchecked="OnSplitViewToggled"
                                  Cursor="Hand"
                                  Padding="10,6"
                                  Margin="0,0,6,0"
                                  ToolTip="Toggle side-by-side / split comparison with original image">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bgBorder"
                                        Background="{StaticResource BrushBgCard}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="{TemplateBinding Padding}">
                                    <TextBlock x:Name="txt" Text="Split View" Foreground="{StaticResource BrushTextSecondary}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bgBorder" Property="Background" Value="{StaticResource BrushBgCardSelected}" />
                                        <Setter TargetName="bgBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                        <Setter TargetName="txt" Property="Foreground" Value="White" />
                                        <Setter TargetName="txt" Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bgBorder" Property="BorderBrush" Value="{StaticResource BrushBorderLight}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bgBorder" Property="Opacity" Value="0.4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Button Style="{StaticResource ModernButton}"
                            Click="OnResetViewClick"
                            ToolTip="Reset zoom and center canvas position"
                            Margin="0,0,6,0">
                        <TextBlock Text="Reset View" />
                    </Button>
                </StackPanel>

                <!-- Right: Save and Batch Buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="ToolbarSaveButton"
                            Style="{StaticResource ModernButton}"
                            Click="OnSaveCurrentClick"
                            IsEnabled="False"
                            ToolTip="Save currently displayed upscaled image"
                            Margin="0,0,8,0">
                        <TextBlock Text="Save Image..." />
                    </Button>

                    <Button Style="{StaticResource AccentButton}"
                            Click="OnBatchFolderClick"
                            ToolTip="Batch upscale multiple images in a folder"
                            Padding="14,6">
                        <TextBlock Text="Batch Folder..." />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN 2-COLUMN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="260" MaxWidth="440" /> <!-- Left Unified Sidebar -->
                <ColumnDefinition Width="*" />                                    <!-- Main Canvas Workspace -->
            </Grid.ColumnDefinitions>

            <!-- LEFT UNIFIED SIDEBAR -->
            <Border Grid.Column="0"
                    Background="{StaticResource BrushBgSidebar}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />    <!-- Top: Model Settings & Actions -->
                        <RowDefinition Height="Auto" /> <!-- Queue Header -->
                        <RowDefinition Height="200" MinHeight="100" MaxHeight="320" /> <!-- Bottom: Images Queue List -->
                        <RowDefinition Height="Auto" /> <!-- Queue Mini Toolbar -->
                    </Grid.RowDefinitions>

                    <!-- Top Controls: Super-Resolution Settings & Actions -->
                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="14,12">
                        <StackPanel>
                            <!-- Section 1: Super-Resolution Models Dropdown -->
                            <TextBlock Text="SUPER-RESOLUTION MODEL"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       Margin="0,0,0,8" />

                            <ComboBox x:Name="ModelSelectionComboBox"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="OnModelSelectionChanged"
                                      Margin="0,0,0,8" />

                            <Border Background="{StaticResource BrushBgCard}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="10,8"
                                    Margin="0,0,0,14">
                                <TextBlock x:Name="ModelDescriptionTextBlock"
                                           Text="Model description will appear here..."
                                           Foreground="{StaticResource BrushTextMuted}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Separator Style="{x:Null}" Height="1" Background="{StaticResource BrushBorder}" Margin="0,0,0,14" />

                            <!-- Section 2: Scale Factor & Tile Size -->
                            <TextBlock Text="UPSCALE CONFIGURATION"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Scale Factor" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6" />
                            <UniformGrid Columns="3" Margin="0,0,0,12">
                                <RadioButton x:Name="Scale2xRadio" Content="2x" GroupName="ScaleFactorGroup" Style="{StaticResource ScaleRadioButton}" Margin="0,0,4,0" />
                                <RadioButton x:Name="Scale4xRadio" Content="4x" IsChecked="True" GroupName="ScaleFactorGroup" Style="{StaticResource ScaleRadioButton}" Margin="2,0,2,0" />
                                <RadioButton x:Name="Scale8xRadio" Content="8x" GroupName="ScaleFactorGroup" Style="{StaticResource ScaleRadioButton}" Margin="4,0,0,0" />
                            </UniformGrid>

                            <TextBlock Text="Tile Size (VRAM Optimization)" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6" />
                            <ComboBox x:Name="TileSizeComboBox" Margin="0,0,0,16">
                                <ComboBoxItem Content="Auto (VRAM Adaptive)" IsSelected="True" Tag="-1" />
                                <ComboBoxItem Content="256px (Low VRAM - 2GB-4GB)" Tag="256" />
                                <ComboBoxItem Content="512px (Medium VRAM - 6GB-8GB)" Tag="512" />
                                <ComboBoxItem Content="768px (High VRAM - 10GB-12GB)" Tag="768" />
                                <ComboBoxItem Content="1024px (Ultra VRAM - 16GB+)" Tag="1024" />
                                <ComboBoxItem Content="Full Image (No Tiling - High VRAM)" Tag="0" />
                            </ComboBox>

                            <Separator Style="{x:Null}" Height="1" Background="{StaticResource BrushBorder}" Margin="0,0,0,16" />

                            <!-- Section 3: Action Triggers -->
                            <TextBlock Text="ACTIONS &amp; EXECUTION"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       Margin="0,0,0,8" />

                            <!-- Upscale Primary Action Button -->
                            <Button x:Name="UpscaleActionButton"
                                    Style="{StaticResource AccentButton}"
                                    Click="OnUpscaleActionClick"
                                    Height="40"
                                    Margin="0,0,0,8">
                                <TextBlock Text="Upscale Image" FontSize="13" FontWeight="SemiBold" />
                            </Button>

                            <!-- Save Output Action Button -->
                            <Button x:Name="SaveActionButton"
                                    Style="{StaticResource ModernButton}"
                                    Click="OnSaveCurrentClick"
                                    IsEnabled="False"
                                    Height="34"
                                    Margin="0,0,0,8">
                                <TextBlock Text="Save Upscaled Image..." />
                            </Button>

                            <!-- Batch Folder Action Button -->
                            <Button Style="{StaticResource ModernButton}"
                                    Click="OnBatchFolderClick"
                                    Height="34"
                                    Margin="0,0,0,4">
                                <TextBlock Text="Batch Folder Upscale..." />
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Section Header: Image Queue -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BrushBgHeader}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,1,0,1"
                            Padding="12,8">
                        <DockPanel>
                            <TextBlock Text="IMAGE QUEUE"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ImageCountTextBlock"
                                       Text="(0)"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushAccent}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Bottom Section: Thumbnails ListBox -->
                    <ListBox x:Name="ImagesListBox"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="OnImageSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Padding="6">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="4" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder"
                                                    Background="{StaticResource BrushBgCard}"
                                                    BorderBrush="{StaticResource BrushBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BrushBgCardHover}" />
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource BrushBorderLight}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BrushBgCardSelected}" />
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:UpscaleItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="#111111"
                                            CornerRadius="2"
                                            Height="44"
                                            Width="56"
                                            HorizontalAlignment="Left">
                                        <Image Source="{Binding ThumbnailBitmap}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <DockPanel>
                                            <TextBlock Text="{Binding FileName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="140" />
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource BrushAccent}"
                                                       HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding OriginalDimensions}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Bottom Section: Queue Toolbar Buttons -->
                    <Border Grid.Row="3"
                            Background="{StaticResource BrushBgHeader}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,1,0,0"
                            Padding="6,4">
                        <UniformGrid Columns="4">
                            <Button Style="{StaticResource ModernButton}"
                                    Click="OnMoveUpClick"
                                    ToolTip="Move image up in queue"
                                    Margin="0,0,2,0">
                                <TextBlock Text="Up" FontSize="10" />
                            </Button>
                            <Button Style="{StaticResource ModernButton}"
                                    Click="OnMoveDownClick"
                                    ToolTip="Move image down in queue"
                                    Margin="2,0,2,0">
                                <TextBlock Text="Down" FontSize="10" />
                            </Button>
                            <Button Style="{StaticResource ModernButton}"
                                    Click="OnDeleteSelectedClick"
                                    ToolTip="Remove selected image from queue"
                                    Margin="2,0,2,0">
                                <TextBlock Text="Del" FontSize="10" Foreground="#ff6b6b" />
                            </Button>
                            <Button Style="{StaticResource ModernButton}"
                                    Click="OnClearAllClick"
                                    ToolTip="Clear all images in queue"
                                    Margin="2,0,0,0">
                                <TextBlock Text="Clear" FontSize="10" />
                            </Button>
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT CANVAS WORKSPACE -->
            <Grid Grid.Column="1" Background="{StaticResource BrushBgApp}">
                <!-- Empty State Placeholder -->
                <Border x:Name="EmptyStateBorder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="30"
                        Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="No Image Loaded"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Drag and drop images here, paste from clipboard (Ctrl+V), or click Import Images"
                                   FontSize="13"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20" />
                        <Button Style="{StaticResource AccentButton}"
                                Click="OnImportImagesClick"
                                HorizontalAlignment="Center"
                                Padding="18,8">
                            <TextBlock Text="Select Image Files" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Active Image Interactive Workspace -->
                <Grid x:Name="ActiveWorkspaceGrid"
                      Visibility="Collapsed"
                      ClipToBounds="True"
                      SizeChanged="OnCanvasContainerSizeChanged"
                      MouseWheel="OnCanvasMouseWheel"
                      MouseDown="OnCanvasMouseDown"
                      MouseMove="OnCanvasMouseMove"
                      MouseUp="OnCanvasMouseUp">

                    <Grid x:Name="ImageTransformGroup">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="CanvasTranslateTransform" X="0" Y="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <!-- Single / Underlying Upscaled Image -->
                        <Image x:Name="UpscaledImageDisplay"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- Split View Layer: Original Image with Clip Geometry -->
                        <Image x:Name="OriginalImageDisplay"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>

                    <!-- Split Comparison Overlay (Curtain Divider & Handle) -->
                    <Canvas x:Name="ComparisonOverlayCanvas" Visibility="Collapsed">
                        <Line x:Name="DividerLine"
                              Stroke="{StaticResource BrushAccent}"
                              StrokeThickness="2"
                              Y1="0"
                              Y2="{Binding ElementName=ActiveWorkspaceGrid, Path=ActualHeight}" />

                        <Border x:Name="SliderHandle"
                                Width="36" Height="36"
                                CornerRadius="18"
                                Background="{StaticResource BrushAccent}"
                                BorderBrush="#ffffff"
                                BorderThickness="2"
                                Cursor="SizeWE"
                                MouseLeftButtonDown="OnHandleMouseDown"
                                MouseLeftButtonUp="OnHandleMouseUp"
                                MouseMove="OnHandleMouseMove">
                            <TextBlock Text="↔" Foreground="#000000" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Before / After Labels -->
                        <Border Canvas.Left="16" Canvas.Top="16" Background="#cc000000" CornerRadius="3" Padding="8,4">
                            <TextBlock Text="BEFORE (Original)" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <Border Canvas.Right="16" Canvas.Top="16" Background="#cc000000" CornerRadius="3" Padding="8,4">
                            <TextBlock Text="AFTER (Upscaled)" Foreground="{StaticResource BrushAccent}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Canvas>

                    <!-- Single View Overlay Badge -->
                    <Border x:Name="SingleViewBadge"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="16"
                            Background="#cc000000"
                            CornerRadius="3"
                            Padding="8,4"
                            Visibility="Collapsed">
                        <TextBlock x:Name="SingleViewBadgeText"
                                   Text="Original Image"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>

                    <!-- Floating Zoom Toolbar (Bottom Right) -->
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="16"
                            Background="#D0181818"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,4">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="-" Width="28" Height="26" Style="{StaticResource ModernButton}" Padding="0" Click="OnZoomOutClick" Margin="0,0,4,0" ToolTip="Zoom Out" />
                            <TextBlock x:Name="ZoomPercentText" Text="100%" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0" Width="45" TextAlignment="Center" />
                            <Button Content="+" Width="28" Height="26" Style="{StaticResource ModernButton}" Padding="0" Click="OnZoomInClick" Margin="4,0,4,0" ToolTip="Zoom In" />
                            <Button Content="Reset" Height="26" Style="{StaticResource ModernButton}" Padding="8,0" Click="OnResetViewClick" Margin="2,0,0,0" ToolTip="Reset Zoom &amp; Pan" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushBgHeader}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel>
                <TextBlock x:Name="StatusTextBlock"
                           Text="Ready. Import images or drag and drop to start."
                           FontSize="11"
                           Foreground="{StaticResource BrushTextSecondary}"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="DetailsTextBlock"
                           Text="No image selected"
                           FontSize="11"
                           Foreground="{StaticResource BrushTextMuted}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- IN-APP PROCESSING PROGRESS MODAL DIALOG (IMMEDIATE RESPONSIVE FULL-WINDOW MODAL) -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="#b3000000"
                x:Name="LoadingOverlay"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Panel.ZIndex="999">
            <Border Background="{StaticResource BrushBgSidebar}"
                    BorderBrush="{StaticResource BrushAccent}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="26,22"
                    MinWidth="420"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="OverlayTitleText"
                                   Text="Processing Super-Resolution"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   DockPanel.Dock="Left" />

                        <TextBlock x:Name="OverlayPercentText"
                                   Text="Starting..."
                                   Foreground="{StaticResource BrushAccent}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   DockPanel.Dock="Right" />
                    </DockPanel>

                    <ProgressBar x:Name="OverlayProgressBar"
                                 IsIndeterminate="True"
                                 Height="6"
                                 Foreground="{StaticResource BrushAccent}"
                                 Background="{StaticResource BrushBgCard}"
                                 BorderThickness="0"
                                 Margin="0,0,0,12" />

                    <TextBlock x:Name="OverlayStatusText"
                               Text="Initializing super-resolution model..."
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>

        <!-- IN-APP SUCCESS MODAL DIALOG -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="#b3000000"
                x:Name="SuccessModalDialog"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Panel.ZIndex="1000">
            <Border Background="{StaticResource BrushBgSidebar}"
                    BorderBrush="{StaticResource BrushAccent}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="24"
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="SuccessModalTitle"
                               Text="Upscaling Complete"
                               FontWeight="Bold"
                               FontSize="15"
                               Foreground="{StaticResource BrushTextPrimary}"
                               Margin="0,0,0,10" />

                    <TextBlock x:Name="SuccessModalMessage"
                               Text="The image was processed and upscaled successfully."
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ModernButton}"
                                Click="OnOpenExportedFolderClick"
                                Margin="0,0,8,0"
                                Padding="12,6">
                            <TextBlock Text="Open Folder" />
                        </Button>
                        <Button x:Name="OpenExportedFileButton"
                                Style="{StaticResource ModernButton}"
                                Click="OnOpenExportedFileClick"
                                Margin="0,0,8,0"
                                Padding="12,6">
                            <TextBlock Text="Open File" />
                        </Button>
                        <Button Style="{StaticResource AccentButton}"
                                Click="OnCloseSuccessModalClick"
                                Padding="16,6">
                            <TextBlock Text="OK" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>

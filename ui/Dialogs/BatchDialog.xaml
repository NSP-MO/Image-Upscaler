<Window x:Class="ImageUpscaler.UI.Dialogs.BatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Folder Processing" Height="440" Width="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgApp}"
        Foreground="{StaticResource BrushTextPrimary}"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Batch Folder Super-Resolution"
                   Foreground="{StaticResource BrushTextPrimary}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Grid.Row="0"
                   Margin="0,0,0,20" />

        <!-- Input Folder -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputFolderBox"
                     Background="{StaticResource BrushBgCard}"
                     Foreground="{StaticResource BrushTextPrimary}"
                     BorderBrush="{StaticResource BrushBorder}"
                     Padding="10,8"
                     FontSize="12"
                     VerticalContentAlignment="Center"
                     Grid.Column="0"
                     Margin="0,0,8,0"
                     IsReadOnly="True" />
            <Button Content="Browse Input..."
                    Style="{StaticResource ModernButton}"
                    Click="OnBrowseInputClick"
                    Grid.Column="1"
                    Height="34"
                    Padding="12,4" />
        </Grid>

        <!-- Output Folder -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="OutputFolderBox"
                     Background="{StaticResource BrushBgCard}"
                     Foreground="{StaticResource BrushTextPrimary}"
                     BorderBrush="{StaticResource BrushBorder}"
                     Padding="10,8"
                     FontSize="12"
                     VerticalContentAlignment="Center"
                     Grid.Column="0"
                     Margin="0,0,8,0"
                     IsReadOnly="True" />
            <Button Content="Browse Output..."
                    Style="{StaticResource ModernButton}"
                    Click="OnBrowseOutputClick"
                    Grid.Column="1"
                    Height="34"
                    Padding="12,4" />
        </Grid>

        <!-- Model Info Card -->
        <Border Grid.Row="3"
                Background="{StaticResource BrushBgSidebar}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="12,8"
                Margin="0,0,0,16">
            <TextBlock x:Name="ModelInfoText"
                       Text="Selected Model: Real-ESRGAN Photo (x4)"
                       Foreground="{StaticResource BrushTextSecondary}"
                       FontSize="12" />
        </Border>

        <!-- Progress Log -->
        <StackPanel Grid.Row="4" VerticalAlignment="Bottom" Margin="0,0,0,16">
            <ProgressBar x:Name="BatchProgressBar"
                         Value="0"
                         Maximum="100"
                         Height="4"
                         Foreground="{StaticResource BrushAccent}"
                         Background="{StaticResource BrushBgSidebar}"
                         Margin="0,0,0,8" />
            <TextBlock x:Name="StatusMessageText"
                       Text="Ready to start batch processing..."
                       Foreground="{StaticResource BrushTextMuted}"
                       FontSize="11" />
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close"
                    Style="{StaticResource ModernButton}"
                    Click="OnCloseClick"
                    Margin="0,0,8,0"
                    Width="80"
                    Height="32" />
            <Button x:Name="StartButton"
                    Content="Start Batch"
                    Style="{StaticResource AccentButton}"
                    Click="OnStartClick"
                    Width="110"
                    Height="32" />
        </StackPanel>
    </Grid>
</Window>

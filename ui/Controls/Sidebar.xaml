<UserControl x:Class="ImageUpscaler.UI.Controls.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320">
    <Border Background="{StaticResource SidebarBgBrush}"
            BorderBrush="{StaticResource BorderBrushKey}"
            BorderThickness="0,0,1,0"
            Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Title Logo Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Background="{StaticResource AccentBrush}" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="▲" Foreground="#000000" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Image Upscaler" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Super-Resolution Image Upscaler" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Section 0: Select File Button -->
                <Button x:Name="SelectFileButton"
                        Content="📂 Select Image File..."
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnSelectFileButtonClick"
                        Height="40"
                        Margin="0,0,0,20" />

                <!-- Section 1: Model Selection -->
                <TextBlock Text="1. SELECT MODEL" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                <ComboBox x:Name="ModelComboBox" SelectionChanged="OnModelSelectionChanged" Height="42" Margin="0,0,0,8" />
                <Border Background="#1C1E26" CornerRadius="6" Padding="12" Margin="0,0,0,20">
                    <TextBlock x:Name="ModelDescText" Text="Model description will appear here..." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <!-- Section 2: Scale Factor -->
                <TextBlock Text="2. UPSCALE FACTOR" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="Scale2xRadio" Content="2x" GroupName="ScaleGroup" Style="{StaticResource {x:Type ToggleButton}}" Grid.Column="0" Margin="0,0,4,0" Height="36" Checked="OnScaleChecked" />
                    <RadioButton x:Name="Scale4xRadio" Content="4x" IsChecked="True" GroupName="ScaleGroup" Style="{StaticResource {x:Type ToggleButton}}" Grid.Column="1" Margin="2,0,2,0" Height="36" Checked="OnScaleChecked" />
                    <RadioButton x:Name="Scale8xRadio" Content="8x" GroupName="ScaleGroup" Style="{StaticResource {x:Type ToggleButton}}" Grid.Column="2" Margin="4,0,0,0" Height="36" Checked="OnScaleChecked" />
                </Grid>

                <!-- Section 3: Tile Size -->
                <TextBlock Text="3. TILE SIZE (VRAM ADAPTIVE OPTIMIZER)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                <ComboBox x:Name="TileSizeComboBox" Height="42" Margin="0,0,0,24">
                    <ComboBoxItem Content="Auto (VRAM Adaptive)" IsSelected="True" Tag="-1" />
                    <ComboBoxItem Content="256px (Low VRAM - 2GB-4GB)" Tag="256" />
                    <ComboBoxItem Content="512px (Medium VRAM - 6GB-8GB)" Tag="512" />
                    <ComboBoxItem Content="768px (High VRAM - 10GB-12GB)" Tag="768" />
                    <ComboBoxItem Content="1024px (Ultra VRAM - 16GB+)" Tag="1024" />
                    <ComboBoxItem Content="Full Image (No Tiling - High VRAM)" Tag="0" />
                </ComboBox>

                <!-- Primary Action Button -->
                <Button x:Name="UpscaleButton"
                        Content="UPSCALE IMAGE"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnUpscaleButtonClick"
                        Height="46"
                        Margin="0,0,0,12" />

                <!-- Secondary Actions -->
                <Button x:Name="SaveButton"
                        Content="💾 Save Upscaled Image"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnSaveButtonClick"
                        IsEnabled="False"
                        Height="38"
                        Margin="0,0,0,8" />

                <Button x:Name="BatchButton"
                        Content="📁 Batch Folder Upscale..."
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnBatchButtonClick"
                        Height="38"
                        Margin="0,0,0,24" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>

<UserControl x:Class="ImageUpscaler.UI.Controls.DropZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             DragOver="OnDragOver"
             Drop="OnDrop"
             MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Border Background="{StaticResource CardBgBrush}"
            BorderBrush="{StaticResource BorderBrushKey}"
            BorderThickness="2"
            CornerRadius="12"
            Padding="30">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="Drag and Drop Image Here" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="or click to browse from computer (PNG, JPG, WEBP, BMP)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
